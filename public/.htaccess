<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve the React app for routes handled in src/App.tsx.
  RewriteRule ^operator/?$ index.html [L]
  RewriteRule ^tracking/?$ index.html [L]
  RewriteRule ^layanan/[^/]+/?$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|svg|png|jpg|jpeg|gif|webp|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
</IfModule>
